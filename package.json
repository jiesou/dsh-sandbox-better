{
  "name": "dsh-sandbox-better",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle: the model's request_write_access tool, session directory grants, its approval card, and tolerant sandbox arguments.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "sandbox",
    "permissions",
    "approval"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiesou/dsh-sandbox-better.git"
  },
  "homepage": "https://github.com/jiesou/dsh-sandbox-better#readme",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test",
    "release": "pnpm version patch && git push --follow-tags"
  },
  "files": [
    "lib",
    "client.js",
    "src",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
